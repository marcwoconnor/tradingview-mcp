{
  "name": "tradingview-mcp",
  "version": "2.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "lint": "eslint src tests",
    "test": "node --test tests/sanitization.test.js tests/replay.test.js tests/pine_analyze.test.js tests/cli.test.js",
    "test:unit": "node --test tests/sanitization.test.js tests/replay.test.js tests/pine_analyze.test.js tests/cli.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:cli": "node --test tests/cli.test.js",
    "test:all": "node --test tests/sanitization.test.js tests/replay.test.js tests/pine_analyze.test.js tests/cli.test.js tests/e2e.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/sanitization.test.js tests/replay.test.js tests/pine_analyze.test.js tests/cli.test.js",
    "test:count": "node --test --test-reporter=spec tests/e2e.test.js 2>&1 | tail -5"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0"
  }
}
